<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Plain platform theme (no Material — see history below for why).
      Light "Shield" palette from colors.xml; colorControl* tints the
      platform switches/checkboxes/radios green without Material.
    -->
    <style name="Theme.UsqueVpn" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/status_connected</item>
        <item name="android:colorControlActivated">@color/status_connected</item>
        <item name="android:colorControlNormal">@color/text_hint</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
