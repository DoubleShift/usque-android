<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <!-- Connection strategy -->
    <CheckBox
        android:id="@+id/auto_mode_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Auto: probe and pick the best connection per network"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="2dp" />

    <CheckBox
        android:id="@+id/speed_first_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Speed first (WireGuard outranks MASQUE when faster)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Protocol -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protocol (manual mode)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <RadioGroup
        android:id="@+id/protocol_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/protocol_masque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MASQUE"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/protocol_wg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="WireGuard"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </RadioGroup>

    <!-- SNI Input (MASQUE only) -->
    <TextView
        android:id="@+id/sni_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SNI (Server Name Indication)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/sni_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="www.visa.cn"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <!-- Endpoint Input -->
    <TextView
        android:id="@+id/endpoint_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Endpoint (host:port)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/endpoint_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="162.159.198.1:443"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="textUri"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/endpoint_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Supported formats:\n• IPv4: 162.159.198.1:443\n• IPv6: [2606:4700:103::1]:443\n• Without port defaults to 443"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
